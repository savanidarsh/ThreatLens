{
  "version": 2,
  "builds": [
    { "src": "api/news.js", "use": "@vercel/node" },
    { "src": "api/conferences.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/news", "dest": "/api/news.js" },
    { "src": "/api/conferences", "dest": "/api/conferences.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
